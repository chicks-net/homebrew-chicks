{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["after 5am on Monday", "after 5am on Tuesday", "after 5am on Wednesday", "after 5am on Thursday", "after 5am on Friday"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["^\\.github/workflows/actionlint\\.ya?ml$"],
      "matchStrings": ["ACTIONLINT_VERSION:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rhysd/actionlint",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["^\\.github/workflows/actionlint\\.ya?ml$"],
      "matchStrings": ["PYFLAKES_VERSION:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "pyflakes"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "automerge": false,
      "minimumReleaseAge": "4 days"
    },
    {
      "matchDepNames": ["bridgecrewio/checkov-action"],
      "overrideDatasource": "git-refs",
      "overridePackageName": "https://github.com/bridgecrewio/checkov-action"
    },
    {
      "matchDepNames": ["Homebrew/actions"],
      "versioning": "loose",
      "extractVersion": "^(?<version>\\d+\\.\\d+\\.\\d+)",
      "description": "Homebrew/actions uses 4-component calver tags (e.g. 2026.08.03.1), but Renovate's pin-comment parser only reads 3 components, so a SHA-pinned ref gets currentValue '2026.08.03'. loose versioning makes that value valid, and extractVersion truncates release tags to the same 3-component form so digest lookups resolve against a real release instead of failing."
    },
    {
      "matchDepNames": ["slsa-framework/slsa-github-generator"],
      "enabled": false,
      "description": "SLSA generator reusable workflow must be pinned by tag (e.g. @v2.1.0), not SHA. SHA-pinning causes 'Invalid ref' errors in the generator's internal builder checkout. See .github/workflows/release.yml."
    },
    {
      "matchDepNames": ["rhysd/actionlint", "pyflakes"],
      "minimumReleaseAge": "4 days"
    }
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "labels": ["dependencies"]
}
